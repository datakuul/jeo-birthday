# ─────────────────────────────────────────────────────────────────────────────
# Janet at 80 — environment variables
# Copy to `.env` for local development. In production (Vercel) set these in the
# project's Environment Variables settings.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database -----------------------------------------------------------------
# Local development (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (Postgres) — set the datasource provider to "postgresql" in
# prisma/schema.prisma, then use a connection string, e.g.:
# DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth.js ------------------------------------------------------------------
# Generate a secret: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Comma-separated admin emails permitted to sign in to /admin.
ADMIN_EMAILS="admin@janetolaniru.com"
# Seeded admin password (used by `npm run db:seed`). Change before production.
ADMIN_PASSWORD="change-me"

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://janetolaniru.com"

# --- Email (Resend) -----------------------------------------------------------
# Optional in dev — when blank, confirmation emails are logged to the console.
RESEND_API_KEY=""
EMAIL_FROM="Janet at 80 <celebration@janetolaniru.com>"
# Shown to guests on confirmation pages / emails so they can reach the family.
HOST_CONTACT_EMAIL="family@janetolaniru.com"

# --- Image uploads (Vercel Blob) ----------------------------------------------
# Optional in dev — when blank, the admin gallery uploader is disabled and
# placeholder images are used. Provisioned automatically when you add Blob
# storage to the Vercel project.
BLOB_READ_WRITE_TOKEN=""
