// Janet at 80 — data model (PostgreSQL / Neon).
//
// DATABASE_URL          → Neon POOLED connection (host has "-pooler"); used by
//                         the app at runtime (serverless-friendly via PgBouncer).
// DIRECT_DATABASE_URL   → Neon DIRECT connection; used by `prisma db push` /
//                         migrations, which can't run over the pooler.
//
// Enum-like fields are stored as String and validated with Zod (see src/lib/validation).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth (Auth.js) + admin
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // for credentials login
  role          String    @default("ADMIN") // ADMIN | EDITOR
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------------------------------
// Honoree, story, gallery, event — public storytelling content
// ----------------------------------------------------------------------------

model HonoreeProfile {
  id          String    @id @default(cuid())
  fullName    String
  honorific   String?
  shortName   String?
  heroTitle   String? // e.g. "Celebrating 80 Years"
  heroSubtitle String? // tagline
  shortBio    String?
  epigraph    String?
  birthPlace  String?
  birthdayDate DateTime?
  heroImage   String?
  portraitImageUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model StoryChapter {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  years     String? // human label, e.g. "1946 – 1964"
  decade    String?
  yearStart Int?
  yearEnd   Int?
  body      String
  quote     String?
  image     String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

model GalleryAlbum {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String?
  sortOrder   Int            @default(0)
  published   Boolean        @default(true)
  images      GalleryImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model GalleryImage {
  id          String       @id @default(cuid())
  albumId     String
  album       GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  // Optimized variant URLs (Vercel Blob) — empty while using placeholders.
  url         String? // primary/largest optimized variant
  thumbUrl    String? // 320px thumbnail
  blurData    String? // base64 blur placeholder
  width       Int?
  height      Int?
  alt         String
  caption     String?
  year        Int?
  isFeatured  Boolean      @default(false)
  isPlaceholder Boolean    @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([albumId, sortOrder])
  @@index([isFeatured])
}

model Event {
  id            String   @id @default(cuid())
  title         String
  venueName     String
  addressLine   String
  city          String?
  startsAt      DateTime
  endsAt        DateTime?
  dressCode     String?
  parking       String?
  accessibility String?
  giftNote      String?
  mapQuery      String?
  venueWebsite  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Guests, households, RSVP, seating
// ----------------------------------------------------------------------------

model Household {
  id                 String   @id @default(cuid())
  name               String
  invitationCode     String   @unique
  primaryContactName String?
  primaryEmail       String?
  primaryPhone       String?
  maxPartySize       Int      @default(2)
  notes              String?
  guests             Guest[]
  rsvp               RsvpSubmission?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([invitationCode])
}

model Guest {
  id           String   @id @default(cuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  displayName  String?
  email        String?
  phone        String?
  relationship String?
  ageGroup     String   @default("ADULT") // ADULT | CHILD | INFANT
  inviteStatus String   @default("INVITED") // INVITED | NOT_INVITED
  // RSVP fields (per-guest)
  rsvpStatus   String   @default("PENDING") // PENDING | ATTENDING | DECLINED | MAYBE
  mealChoice   String? // STANDARD | VEGETARIAN | VEGAN | HALAL | CHILD
  allergies    String?
  accessibility String?
  notes        String?
  seat         SeatAssignment?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([householdId])
  @@index([rsvpStatus])
}

model RsvpSubmission {
  id          String   @id @default(cuid())
  householdId String   @unique
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING | ATTENDING | DECLINED | MAYBE | PARTIAL
  partySize   Int      @default(0)
  submittedByName  String?
  submittedByEmail String?
  submittedByPhone String?
  message     String?
  ipHash      String? // hashed IP for light rate-limiting / abuse triage
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Table {
  id        String           @id @default(cuid())
  name      String
  capacity  Int              @default(10)
  notes     String?
  sortOrder Int              @default(0)
  seats     SeatAssignment[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model SeatAssignment {
  id        String   @id @default(cuid())
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guestId   String   @unique // a guest sits at exactly one table
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  seatNo    Int?
  createdAt DateTime @default(now())

  @@index([tableId])
}

model Tribute {
  id           String   @id @default(cuid())
  author       String
  relationship String?
  email        String?
  message      String
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String // CREATE | UPDATE | DELETE | IMPORT | EXPORT | APPROVE | REJECT
  entityType  String // Guest | Household | Rsvp | Seating | Tribute | Story | Gallery
  entityId    String?
  metadata    String? // JSON string describing the change
  createdAt   DateTime @default(now())

  @@index([entityType, createdAt])
}
